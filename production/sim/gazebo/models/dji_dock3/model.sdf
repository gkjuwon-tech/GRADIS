<?xml version="1.0"?>
<!--
  DJI Dock 3 디지털 트윈 — M4TD 자동 충전/출격 스테이션.
  실물 근사 스케일(개방 상태): 본체 ~1.0 x 0.8 x 0.55 m, 양쪽 리드 패널 개방,
  내부 착륙 패드(드론은 패드 위에서 스폰), 상태 LED, 기상 센서 마스트.
  시뮬에선 정적(static) — 충전/재출격 로직은 companion의 도크 상태머신이 담당.
-->
<sdf version="1.9">
  <model name="dji_dock3">
    <static>true</static>
    <link name="body">
      <!-- 받침 베이스 -->
      <visual name="base">
        <pose>0 0 0.06 0 0 0</pose>
        <geometry><box><size>1.15 0.95 0.12</size></box></geometry>
        <material><ambient>0.25 0.25 0.26 1</ambient><diffuse>0.35 0.35 0.37 1</diffuse></material>
      </visual>
      <collision name="base_col">
        <pose>0 0 0.06 0 0 0</pose>
        <geometry><box><size>1.15 0.95 0.12</size></box></geometry>
      </collision>

      <!-- 본체 (화이트 인클로저) -->
      <visual name="shell">
        <pose>0 0 0.30 0 0 0</pose>
        <geometry><box><size>1.0 0.8 0.36</size></box></geometry>
        <material><ambient>0.75 0.76 0.78 1</ambient><diffuse>0.88 0.89 0.91 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular></material>
      </visual>
      <collision name="shell_col">
        <pose>0 0 0.30 0 0 0</pose>
        <geometry><box><size>1.0 0.8 0.36</size></box></geometry>
      </collision>

      <!-- 개방된 리드 패널 (좌/우, 바깥으로 젖혀짐) -->
      <visual name="lid_l">
        <pose>0 0.55 0.50 -0.55 0 0</pose>
        <geometry><box><size>1.0 0.42 0.02</size></box></geometry>
        <material><diffuse>0.85 0.86 0.88 1</diffuse></material>
      </visual>
      <visual name="lid_r">
        <pose>0 -0.55 0.50 0.55 0 0</pose>
        <geometry><box><size>1.0 0.42 0.02</size></box></geometry>
        <material><diffuse>0.85 0.86 0.88 1</diffuse></material>
      </visual>

      <!-- 내부 착륙 패드 (H 마커) — 드론 스폰 위치 z≈0.50 -->
      <visual name="pad">
        <pose>0 0 0.485 0 0 0</pose>
        <geometry><box><size>0.6 0.6 0.01</size></box></geometry>
        <material><diffuse>0.12 0.12 0.13 1</diffuse></material>
      </visual>
      <collision name="pad_col">
        <pose>0 0 0.485 0 0 0</pose>
        <geometry><box><size>0.6 0.6 0.01</size></box></geometry>
      </collision>
      <visual name="pad_marker">
        <pose>0 0 0.492 0 0 0</pose>
        <geometry><cylinder><radius>0.2</radius><length>0.004</length></cylinder></geometry>
        <material><diffuse>0.85 0.74 0.28 1</diffuse></material>
      </visual>
      <visual name="pad_marker_core">
        <pose>0 0 0.495 0 0 0</pose>
        <geometry><cylinder><radius>0.07</radius><length>0.004</length></cylinder></geometry>
        <material><diffuse>0.12 0.12 0.13 1</diffuse></material>
      </visual>

      <!-- 상태 LED 바 -->
      <visual name="led">
        <pose>0.505 0 0.42 0 0 0</pose>
        <geometry><box><size>0.012 0.3 0.03</size></box></geometry>
        <material><emissive>0.1 0.7 0.25 1</emissive><diffuse>0.1 0.6 0.25 1</diffuse></material>
      </visual>

      <!-- 기상 센서 마스트 (풍속/강우) -->
      <visual name="mast">
        <pose>-0.42 -0.32 0.78 0 0 0</pose>
        <geometry><cylinder><radius>0.012</radius><length>0.6</length></cylinder></geometry>
        <material><diffuse>0.4 0.4 0.42 1</diffuse></material>
      </visual>
      <visual name="anemometer">
        <pose>-0.42 -0.32 1.1 0 0 0</pose>
        <geometry><sphere><radius>0.035</radius></sphere></geometry>
        <material><diffuse>0.7 0.7 0.72 1</diffuse></material>
      </visual>

      <!-- 야간용 패드 조명 -->
      <light name="pad_light" type="point">
        <pose>0 0 0.9 0 0 0</pose>
        <diffuse>0.8 0.85 0.95 1</diffuse>
        <attenuation><range>8</range><constant>0.4</constant>
          <linear>0.2</linear><quadratic>0.05</quadratic></attenuation>
        <cast_shadows>false</cast_shadows>
        <intensity>1.2</intensity>
      </light>
    </link>
  </model>
</sdf>
