<?xml version="1.0"?>
<!-- 가로등 (7m 폴 + 웜화이트 포인트 라이트) — 야간 도시의 빛 웅덩이.
     불빛 아래는 보이고, 사이는 어둡다 — night_mode/thermal 툴 유도 환경. -->
<sdf version="1.9">
  <model name="streetlight">
    <static>true</static>
    <link name="pole">
      <visual name="pole_v">
        <pose>0 0 3.5 0 0 0</pose>
        <geometry><cylinder><radius>0.08</radius><length>7</length></cylinder></geometry>
        <material><diffuse>0.15 0.15 0.16 1</diffuse></material>
      </visual>
      <visual name="arm">
        <pose>0.6 0 6.9 0 1.35 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>1.3</length></cylinder></geometry>
        <material><diffuse>0.15 0.15 0.16 1</diffuse></material>
      </visual>
      <visual name="lamp">
        <pose>1.15 0 6.7 0 0 0</pose>
        <geometry><box><size>0.5 0.22 0.12</size></box></geometry>
        <material><emissive>0.9 0.75 0.45 1</emissive><diffuse>0.9 0.8 0.5 1</diffuse></material>
      </visual>
      <light name="lamp_light" type="point">
        <pose>1.15 0 6.55 0 0 0</pose>
        <diffuse>0.95 0.8 0.55 1</diffuse>
        <specular>0.2 0.18 0.12 1</specular>
        <attenuation><range>26</range><constant>0.25</constant>
          <linear>0.045</linear><quadratic>0.0035</quadratic></attenuation>
        <cast_shadows>false</cast_shadows>
        <intensity>2.4</intensity>
      </light>
    </link>
  </model>
</sdf>
