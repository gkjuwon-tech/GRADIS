#VRML_SIM R2025a utf8
# GRADIS 디지털 트윈 — 도시 순찰 구역
#
# 월드 원점(0,0,0) = SITL --home = config/defender25.json의 DOCK-A 좌표
# (37.52860, 126.96520). 좌표계 ENU: x=동, y=북, z=상.
# 순찰 사각형(config patrol)은 대략 x∈[-44,+35], y∈[-33,+33] 영역.
#
# 액터:
#   (15, 12)   몸싸움 2인 — t=40s에 한 명 쓰러져 미동 없음 (FALL→DOWN 시나리오)
#   (-12, -9)  가만히 있는 행인 (대조군 — 얘 보고 알람 울리면 오탐)

EXTERNPROTO "../protos/Defender25.proto"
EXTERNPROTO "../protos/FightHuman.proto"

WorldInfo {
  title "GRADIS digital twin - Riverside Park Area 2"
  basicTimeStep 32
  coordinateSystem "ENU"
}
Viewpoint {
  orientation -0.35 0.35 0.87 1.72
  position 60 -55 55
}
Background {
  skyColor [ 0.53 0.71 0.92 ]
}
DirectionalLight {
  direction -0.4 -0.5 -1
  intensity 2.2
  castShadows TRUE
}
DirectionalLight {
  direction 0.6 0.4 -0.5
  intensity 0.7
}

# ---- 지면: 공원 잔디 + 아스팔트 광장/도로 ------------------------------------
Solid {
  name "ground_grass"
  translation 0 0 -0.05
  children [ Shape {
    appearance PBRAppearance { baseColor 0.32 0.44 0.26 roughness 1 metalness 0 }
    geometry Box { size 400 400 0.1 }
  } ]
  locked TRUE
}
Solid {
  name "plaza"
  translation 8 6 0.005
  children [ Shape {
    appearance PBRAppearance { baseColor 0.42 0.42 0.44 roughness 0.95 metalness 0 }
    geometry Box { size 60 44 0.01 }
  } ]
  locked TRUE
}
Solid {
  name "road_ew"
  translation 0 -44 0.005
  children [ Shape {
    appearance PBRAppearance { baseColor 0.22 0.22 0.24 roughness 0.9 metalness 0 }
    geometry Box { size 240 9 0.01 }
  } ]
  locked TRUE
}
Solid {
  name "road_ns"
  translation -52 0 0.005
  children [ Shape {
    appearance PBRAppearance { baseColor 0.22 0.22 0.24 roughness 0.9 metalness 0 }
    geometry Box { size 9 240 0.01 }
  } ]
  locked TRUE
}

# ---- 빌딩 스카이라인 (순찰 사각형 바깥) ----------------------------------------
Solid { name "bldg1" translation -75 30 14 children [ Shape {
  appearance PBRAppearance { baseColor 0.55 0.52 0.48 roughness 0.8 }
  geometry Box { size 22 18 28 } } ] locked TRUE }
Solid { name "bldg2" translation -78 -35 20 children [ Shape {
  appearance PBRAppearance { baseColor 0.35 0.42 0.50 roughness 0.4 metalness 0.6 }
  geometry Box { size 18 24 40 } } ] locked TRUE }
Solid { name "bldg3" translation 65 45 11 children [ Shape {
  appearance PBRAppearance { baseColor 0.62 0.48 0.40 roughness 0.9 }
  geometry Box { size 26 20 22 } } ] locked TRUE }
Solid { name "bldg4" translation 70 -25 16 children [ Shape {
  appearance PBRAppearance { baseColor 0.50 0.50 0.55 roughness 0.5 metalness 0.4 }
  geometry Box { size 20 30 32 } } ] locked TRUE }
Solid { name "bldg5" translation 10 70 13 children [ Shape {
  appearance PBRAppearance { baseColor 0.58 0.55 0.50 roughness 0.85 }
  geometry Box { size 34 16 26 } } ] locked TRUE }
Solid { name "bldg6" translation -25 -75 9 children [ Shape {
  appearance PBRAppearance { baseColor 0.66 0.60 0.52 roughness 0.9 }
  geometry Box { size 28 18 18 } } ] locked TRUE }
Solid { name "bldg7" translation 35 -70 24 children [ Shape {
  appearance PBRAppearance { baseColor 0.30 0.36 0.44 roughness 0.3 metalness 0.7 }
  geometry Box { size 16 16 48 } } ] locked TRUE }

# ---- 나무 (장애물 + VLM 항법 판단 거리) ----------------------------------------
Solid { name "tree1" translation -8 18 0 children [
  Transform { translation 0 0 2 children [ Shape {
    appearance PBRAppearance { baseColor 0.36 0.25 0.16 roughness 1 }
    geometry Cylinder { height 4 radius 0.25 } } ] }
  Transform { translation 0 0 5.2 children [ Shape {
    appearance PBRAppearance { baseColor 0.22 0.38 0.18 roughness 1 }
    geometry Sphere { radius 2.6 } } ] }
] locked TRUE }
Solid { name "tree2" translation 28 -6 0 children [
  Transform { translation 0 0 1.8 children [ Shape {
    appearance PBRAppearance { baseColor 0.36 0.25 0.16 roughness 1 }
    geometry Cylinder { height 3.6 radius 0.22 } } ] }
  Transform { translation 0 0 4.6 children [ Shape {
    appearance PBRAppearance { baseColor 0.25 0.42 0.20 roughness 1 }
    geometry Sphere { radius 2.2 } } ] }
] locked TRUE }
Solid { name "tree3" translation -20 2 0 children [
  Transform { translation 0 0 2.2 children [ Shape {
    appearance PBRAppearance { baseColor 0.36 0.25 0.16 roughness 1 }
    geometry Cylinder { height 4.4 radius 0.28 } } ] }
  Transform { translation 0 0 5.8 children [ Shape {
    appearance PBRAppearance { baseColor 0.20 0.36 0.16 roughness 1 }
    geometry Sphere { radius 2.9 } } ] }
] locked TRUE }

# ---- 도킹스테이션 (원점 = DOCK-A) ----------------------------------------------
Solid {
  name "dock_a"
  translation 0 0 0.15
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.85 0.74 0.28 roughness 0.7 }
      geometry Box { size 1.6 1.6 0.3 }
    }
    Transform { translation 0 0 0.16 children [ Shape {
      appearance PBRAppearance { baseColor 0.1 0.1 0.1 roughness 0.9 }
      geometry Cylinder { height 0.02 radius 0.5 }
    } ] }
  ]
  locked TRUE
}

# ---- 액터들 -------------------------------------------------------------------
FightHuman {
  translation 15 12.7 0
  rotation 0 0 1 -1.5708
  name "aggressor"
  controllerArgs [ "--role", "aggressor", "--fall-at", "40", "--cycle", "120" ]
  shirtColor 0.16 0.18 0.22
  pantsColor 0.10 0.10 0.12
}
FightHuman {
  translation 15 11.3 0
  rotation 0 0 1 1.5708
  name "victim"
  controllerArgs [ "--role", "victim", "--fall-at", "40", "--cycle", "120" ]
  shirtColor 0.70 0.62 0.48
  pantsColor 0.25 0.28 0.35
}
FightHuman {
  translation -12 -9 0
  rotation 0 0 1 0.6
  name "bystander"
  controllerArgs [ "--role", "idle" ]
  shirtColor 0.20 0.42 0.30
  pantsColor 0.15 0.15 0.18
}

# ---- 드론 (포즈는 ArduCopter SITL이 결정) ---------------------------------------
Defender25 {
  translation 0 0 0.35
  name "GRADIS-DEFENDER25-01"
  controllerArgs [ "--home", "37.52860", "126.96520" ]
}
